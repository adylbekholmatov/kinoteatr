<Page x:Class="AKICinemaAdmin.Views.BookingSuccessPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BgBrush}"
      Title="Билет оформлен">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel HorizontalAlignment="Center" MaxWidth="540" Margin="40">

            <!-- Success icon -->
            <Border Width="80" Height="80" CornerRadius="40"
                    Background="#1A22C55E" HorizontalAlignment="Center" Margin="0,0,0,16">
                <TextBlock Text="✓" FontSize="40" FontWeight="Bold"
                           Foreground="{StaticResource SuccessBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <TextBlock Text="Билет успешно оформлен!" Foreground="White"
                       FontSize="22" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,0,0,6"/>
            <TextBlock x:Name="SubtitleText" Foreground="{StaticResource MutedBrush}"
                       FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,32"/>

            <!-- Ticket card -->
            <Border Background="{StaticResource Bg2Brush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="12" Margin="0,0,0,20">
                <StackPanel>

                    <!-- Ticket header -->
                    <Border Background="#1A0A0A" CornerRadius="12,12,0,0" Padding="24,18">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="4" Height="20" Fill="{StaticResource AccentBrush}"
                                           RadiusX="2" RadiusY="2" Margin="0,0,10,0"/>
                                <TextBlock VerticalAlignment="Center">
                                    <Run Text="AKI" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="16"/>
                                    <Run Text="CINEMA" Foreground="White" FontSize="16"/>
                                </TextBlock>
                            </StackPanel>
                            <TextBlock x:Name="BookingCodeLabel"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontFamily="Courier New" FontSize="14" FontWeight="Bold"/>
                        </Grid>
                    </Border>

                    <!-- Dashed separator -->
                    <Line X1="0" X2="1" Stroke="{StaticResource BorderBrush}"
                          StrokeThickness="1" StrokeDashArray="6,4"
                          Stretch="Fill" Margin="20,0"/>

                    <!-- Ticket body — используем Border для Padding вместо StackPanel -->
                    <Border Padding="24,16,24,24">
                        <StackPanel>
                            <TextBlock x:Name="TicketMovieLabel" Foreground="White"
                                       FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="ДАТА" Foreground="{StaticResource MutedBrush}"
                                               FontSize="9" FontWeight="Bold"/>
                                    <TextBlock x:Name="TicketDateLabel" Foreground="White" FontSize="14" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="ВРЕМЯ" Foreground="{StaticResource MutedBrush}"
                                               FontSize="9" FontWeight="Bold"/>
                                    <TextBlock x:Name="TicketTimeLabel" Foreground="White" FontSize="14" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="ЗАЛ" Foreground="{StaticResource MutedBrush}"
                                               FontSize="9" FontWeight="Bold"/>
                                    <TextBlock x:Name="TicketHallLabel" Foreground="White" FontSize="14" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="МЕСТ" Foreground="{StaticResource MutedBrush}"
                                               FontSize="9" FontWeight="Bold"/>
                                    <TextBlock x:Name="TicketSeatsCountLabel" Foreground="White" FontSize="14" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="МЕСТА" Foreground="{StaticResource MutedBrush}"
                                       FontSize="9" FontWeight="Bold" Margin="0,0,0,8"/>
                            <WrapPanel x:Name="SeatsWrapPanel" Margin="0,0,0,16"/>

                            <!-- Total -->
                            <Border Background="{StaticResource Bg3Brush}" CornerRadius="8" Padding="14,10">
                                <Grid>
                                    <TextBlock Text="ИТОГО К ОПЛАТЕ" Foreground="{StaticResource MutedBrush}"
                                               FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TicketTotalLabel"
                                               HorizontalAlignment="Right"
                                               Foreground="{StaticResource AccentBrush}"
                                               FontSize="22" FontWeight="Bold"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Border>

            <!-- Actions -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="🖨  Распечатать"
                        Style="{StaticResource OutlineButtonStyle}"
                        Height="42" Click="PrintButton_Click"/>
                <Button Grid.Column="2" Content="🎟  Новый билет"
                        Style="{StaticResource RedButtonStyle}"
                        Height="42" Click="NewBookingButton_Click"/>
            </Grid>

            <TextBlock Text="Статус брони: Зарезервировано (касса)"
                       Foreground="{StaticResource MutedBrush}" FontSize="11"
                       HorizontalAlignment="Center" Margin="0,8,0,0"/>
        </StackPanel>
    </ScrollViewer>
</Page>
