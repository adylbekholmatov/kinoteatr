<Page x:Class="AKICinemaAdmin.Views.ScanTicketPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Проверка билета"
      Background="{StaticResource BgBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="🎫" FontSize="24" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock Text="Проверка билета на входе"
                       Foreground="White" FontSize="20" FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Camera preview -->
        <Border Grid.Row="1" Grid.Column="0"
                Background="Black"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="12"
                Margin="0,0,16,0">
            <Grid>
                <Image x:Name="CameraImage" Stretch="Uniform"/>

                <!-- Placeholder when camera off -->
                <StackPanel x:Name="CameraPlaceholder"
                            VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="📷" FontSize="56" HorizontalAlignment="Center"/>
                    <TextBlock Text="Камера выключена" Foreground="{StaticResource MutedBrush}"
                               FontSize="15" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    <TextBlock Text="Нажмите «Включить камеру»" Foreground="{StaticResource MutedBrush}"
                               FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Scan frame overlay -->
                <Border x:Name="ScanFrame" Width="240" Height="240"
                        BorderBrush="#22C55E" BorderThickness="3" CornerRadius="12"
                        Visibility="Collapsed"/>

                <!-- Camera controls -->
                <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center"
                            Margin="0,0,0,20">

                    <!-- Camera picker -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                Margin="0,0,0,10">
                        <ComboBox x:Name="CameraSelect"
                                  Width="280" Height="34"
                                  VerticalContentAlignment="Center"
                                  Style="{StaticResource AkiComboBox}"
                                  SelectionChanged="CameraSelect_SelectionChanged"
                                  ToolTip="Какую камеру использовать для сканирования"/>
                        <Button x:Name="RefreshCamerasBtn" Content="↻"
                                Width="34" Height="34" Margin="6,0,0,0" Padding="0"
                                FontSize="15"
                                Style="{StaticResource BaseButtonStyle}"
                                Background="{StaticResource Bg3Brush}" Foreground="White"
                                Click="RefreshCamerasBtn_Click"
                                ToolTip="Обновить список камер"/>
                    </StackPanel>

                    <Button x:Name="CameraBtn" Content="▶  Включить камеру"
                            HorizontalAlignment="Center"
                            Height="42" Padding="24,0"
                            Style="{StaticResource RedButtonStyle}"
                            Click="CameraBtn_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Right panel -->
        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Manual entry -->
            <Border Grid.Row="0" Background="{StaticResource Bg2Brush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="10"
                    Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Ручной ввод кода" Foreground="{StaticResource MutedBrush}"
                               FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBox x:Name="ManualCodeBox"
                             Style="{StaticResource AkiTextBox}"
                             FontSize="15" FontFamily="Consolas"
                             KeyDown="ManualCodeBox_KeyDown"/>
                    <TextBlock Text="BAYEL-XXXXXXXX · Enter для проверки"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="11" Margin="0,6,0,0"/>
                    <Button Content="🔍  Проверить билет"
                            Style="{StaticResource RedButtonStyle}"
                            Height="40" Margin="0,10,0,0"
                            Click="CheckBtn_Click"/>
                </StackPanel>
            </Border>

            <!-- Result panel -->
            <Border Grid.Row="1" x:Name="ResultBorder"
                    Background="{StaticResource Bg2Brush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="2" CornerRadius="10"
                    Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Idle state -->
                        <StackPanel x:Name="IdlePanel" VerticalAlignment="Center" Margin="0,40,0,0">
                            <TextBlock Text="⏳" FontSize="40" HorizontalAlignment="Center"/>
                            <TextBlock Text="Ожидание сканирования"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="14" HorizontalAlignment="Center" Margin="0,10,0,0"
                                       TextWrapping="Wrap" TextAlignment="Center"/>
                        </StackPanel>

                        <!-- Result -->
                        <StackPanel x:Name="ResultPanel" Visibility="Collapsed">
                            <TextBlock x:Name="ResultIcon" FontSize="44" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="ResultTitle" FontSize="18" FontWeight="Bold"
                                       HorizontalAlignment="Center" Margin="0,8,0,0"
                                       TextWrapping="Wrap" TextAlignment="Center"/>
                            <TextBlock x:Name="ResultReason" FontSize="13"
                                       Foreground="{StaticResource MutedBrush}"
                                       HorizontalAlignment="Center" Margin="0,6,0,0"
                                       TextWrapping="Wrap" TextAlignment="Center"/>

                            <Border x:Name="DetailsBox" Background="{StaticResource Bg3Brush}"
                                    CornerRadius="8" Padding="14" Margin="0,16,0,0"
                                    Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock x:Name="DetMovie" Foreground="White"
                                               FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="DetTime" Foreground="{StaticResource AccentBrush}"
                                               FontSize="13" Margin="0,4,0,0"/>
                                    <TextBlock x:Name="DetHall" Foreground="{StaticResource MutedBrush}"
                                               FontSize="12" Margin="0,2,0,0"/>

                                    <Separator Background="{StaticResource BorderBrush}" Margin="0,10"/>

                                    <TextBlock x:Name="DetSeatsCount" Foreground="#22C55E"
                                               FontSize="20" FontWeight="Bold"/>
                                    <ItemsControl x:Name="SeatsList" Margin="0,6,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Foreground="White"
                                                           FontSize="13" Margin="0,2,0,0"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Separator Background="{StaticResource BorderBrush}" Margin="0,10"/>

                                    <TextBlock x:Name="DetCode" Foreground="White"
                                               FontSize="13" FontFamily="Consolas"/>
                                    <TextBlock x:Name="DetAmount" Foreground="{StaticResource MutedBrush}"
                                               FontSize="12" Margin="0,4,0,0"/>
                                    <TextBlock x:Name="DetPhone" Foreground="{StaticResource MutedBrush}"
                                               FontSize="12" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <Button Content="Сканировать следующий"
                                    Style="{StaticResource OutlineButtonStyle}"
                                    Height="38" Margin="0,16,0,0"
                                    Click="ResetBtn_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
