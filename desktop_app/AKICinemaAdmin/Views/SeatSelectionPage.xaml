<Page x:Class="AKICinemaAdmin.Views.SeatSelectionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BgBrush}"
      Title="Выбор мест">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource Bg2Brush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="20,14">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="← Назад" Click="BackButton_Click"
                            Style="{StaticResource OutlineButtonStyle}"
                            Padding="12,6" FontSize="12" Margin="0,0,16,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="MovieTitleLabel" Foreground="White"
                                   FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock x:Name="ScreeningInfoLabel" Foreground="{StaticResource MutedBrush}"
                                   FontSize="12" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- ═══ SEAT MAP ═══ -->
            <Grid Grid.Column="0" Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Screen -->
                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,20">
                    <TextBlock Text="ЭКРАН" Foreground="{StaticResource MutedBrush}"
                               FontSize="10" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <Border Height="6" Width="400" CornerRadius="3,3,0,0"
                            Background="{StaticResource AccentBrush}" Opacity="0.6"/>
                    <Border Height="3" Width="360" CornerRadius="0"
                            Background="{StaticResource AccentBrush}" Opacity="0.2" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Legend -->
                <WrapPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal" Margin="0,0,32,0">
                        <Border Width="28" Height="28" CornerRadius="6"
                                Background="#2A2A2A" BorderBrush="#555" BorderThickness="1" Margin="0,0,10,0"/>
                        <TextBlock Text="Свободно" Foreground="{StaticResource MutedBrush}" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,32,0">
                        <Border Width="28" Height="28" CornerRadius="6"
                                Background="{StaticResource AccentBrush}" Margin="0,0,10,0"/>
                        <TextBlock Text="Выбрано" Foreground="{StaticResource MutedBrush}" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="28" Height="28" CornerRadius="6"
                                Background="#222" BorderBrush="#333" BorderThickness="1" Margin="0,0,10,0"/>
                        <TextBlock Text="Занято" Foreground="{StaticResource MutedBrush}" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                </WrapPanel>

                <!-- Loading / Seat grid -->
                <Grid Grid.Row="2">
                    <StackPanel x:Name="SeatLoadingPanel" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="⏳" FontSize="32" HorizontalAlignment="Center"/>
                        <TextBlock Text="Загрузка схемы зала..." Foreground="{StaticResource MutedBrush}"
                                   FontSize="13" Margin="0,8,0,0"/>
                    </StackPanel>
                    <ScrollViewer x:Name="SeatScrollView" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <StackPanel x:Name="SeatMapPanel" HorizontalAlignment="Center"/>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- ═══ ORDER PANEL ═══ -->
            <Border Grid.Column="1" Background="{StaticResource Bg2Brush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Scrollable content -->
                        <RowDefinition Height="*"/>
                        <!-- Fixed bottom: total + button -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ── Scrollable top section ── -->
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="20,20,20,0">
                        <StackPanel>
                            <TextBlock Text="Оформление билета" Foreground="White"
                                       FontSize="15" FontWeight="SemiBold" Margin="0,0,0,16"/>

                            <!-- Selected seats -->
                            <TextBlock Text="Выбранные места:" Foreground="{StaticResource MutedBrush}"
                                       FontSize="11" Margin="0,0,0,8"/>
                            <Border Background="{StaticResource Bg3Brush}" CornerRadius="8"
                                    MinHeight="60" Padding="12" Margin="0,0,0,16">
                                <StackPanel x:Name="SelectedSeatsList">
                                    <TextBlock x:Name="NoSeatsHint" Text="Нажмите на место в схеме"
                                               Foreground="{StaticResource MutedBrush}" FontSize="12"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Margin="0,8,0,8"/>
                                </StackPanel>
                            </Border>

                            <!-- Separator -->
                            <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,16"/>

                            <!-- Customer info -->
                            <TextBlock Text="Данные клиента" Foreground="White"
                                       FontSize="13" FontWeight="SemiBold" Margin="0,0,0,12"/>

                            <TextBlock Text="Номер телефона *" Foreground="{StaticResource MutedBrush}"
                                       FontSize="11" Margin="0,0,0,6"/>
                            <TextBox x:Name="PhoneBox" Style="{StaticResource AkiTextBox}"
                                     Margin="0,0,0,12" Text="+996 "/>

                            <TextBlock Text="Email (необязательно)" Foreground="{StaticResource MutedBrush}"
                                       FontSize="11" Margin="0,0,0,6"/>
                            <TextBox x:Name="EmailBox" Style="{StaticResource AkiTextBox}"
                                     Margin="0,0,0,16"/>

                            <!-- Separator -->
                            <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,16"/>

                            <!-- Seat count + price per seat -->
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Количество мест:" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                                <TextBlock x:Name="SeatsCountLabel" Text="0"
                                           HorizontalAlignment="Right" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Цена за место:" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                                <TextBlock x:Name="PriceLabel" Text="0 сом"
                                           HorizontalAlignment="Right" Foreground="White" FontSize="12"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ── Fixed bottom section ── -->
                    <Border Grid.Row="1"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                            Padding="20,16,20,20" Background="{StaticResource Bg2Brush}">
                        <StackPanel>
                            <!-- Total -->
                            <Border Background="{StaticResource Bg3Brush}" CornerRadius="8"
                                    Padding="12,10" Margin="0,0,0,12">
                                <Grid>
                                    <TextBlock Text="ИТОГО:" Foreground="{StaticResource MutedBrush}"
                                               FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TotalLabel" Text="0 сом"
                                               HorizontalAlignment="Right"
                                               Foreground="{StaticResource AccentBrush}"
                                               FontSize="20" FontWeight="Bold"/>
                                </Grid>
                            </Border>

                            <!-- Error -->
                            <Border x:Name="ErrorBorder" Visibility="Collapsed"
                                    Background="#1AEF4444" BorderBrush="#EF4444"
                                    BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                                <TextBlock x:Name="ErrorText" Foreground="#EF4444" FontSize="12" TextWrapping="Wrap"/>
                            </Border>

                            <!-- Book button -->
                            <Button x:Name="BookButton" Content="🎟  Оформить билет"
                                    Style="{StaticResource RedButtonStyle}"
                                    Height="44" FontSize="14" IsEnabled="False"
                                    Click="BookButton_Click"/>

                            <TextBlock Text="Бронь создаётся как «Зарезервировано»"
                                       Foreground="{StaticResource MutedBrush}" FontSize="10"
                                       HorizontalAlignment="Center" Margin="0,8,0,0" TextWrapping="Wrap"
                                       TextAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
