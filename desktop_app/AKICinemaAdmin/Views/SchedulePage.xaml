<Page x:Class="AKICinemaAdmin.Views.SchedulePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BgBrush}"
      Title="Расписание">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource Bg2Brush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="24,16">
            <Grid>
                <StackPanel>
                    <TextBlock Text="Расписание сеансов" Foreground="White"
                               FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock x:Name="SubtitleLabel" Foreground="{StaticResource MutedBrush}"
                               FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Дата:" Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center" Margin="0,0,10,0" FontSize="13"/>
                    <DatePicker x:Name="DatePicker" Width="140" Height="34"
                                Background="{StaticResource Bg3Brush}"
                                Foreground="White"
                                SelectedDateChanged="DatePicker_SelectedDateChanged"
                                FontSize="13"/>
                    <Button Content="🔄 Обновить" Margin="10,0,0,0"
                            Style="{StaticResource OutlineButtonStyle}"
                            Height="34" Click="RefreshButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Date strip -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled"
                      Background="{StaticResource Bg2Brush}"
                      Padding="16,12">
            <StackPanel x:Name="DateStrip" Orientation="Horizontal"/>
        </ScrollViewer>

        <!-- Content -->
        <Grid Grid.Row="2">
            <!-- Loading -->
            <StackPanel x:Name="LoadingPanel" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="⏳" FontSize="40" HorizontalAlignment="Center"/>
                <TextBlock Text="Загрузка расписания..." Foreground="{StaticResource MutedBrush}"
                           Margin="0,10,0,0" FontSize="14"/>
            </StackPanel>

            <!-- Empty -->
            <StackPanel x:Name="EmptyPanel" Visibility="Collapsed"
                        VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="📅" FontSize="48" HorizontalAlignment="Center"/>
                <TextBlock Text="Сеансов на эту дату нет" Foreground="{StaticResource MutedBrush}"
                           FontSize="16" Margin="0,12,0,0" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Screenings list -->
            <ScrollViewer x:Name="ListScroll" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ScreeningsList" Margin="20"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
