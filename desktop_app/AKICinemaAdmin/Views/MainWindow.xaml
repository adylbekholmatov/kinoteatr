<Window x:Class="AKICinemaAdmin.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AKI Cinema — Касса"
        Width="1200" Height="760"
        MinWidth="900" MinHeight="600"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        WindowStyle="None"
        AllowsTransparency="True"
        StateChanged="Window_StateChanged">

    <Border Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ═══ TITLE BAR ═══ -->
            <Border Grid.Row="0" Grid.ColumnSpan="2"
                    Background="{StaticResource Bg2Brush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="10,10,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Rectangle Width="4" Height="18" Fill="{StaticResource AccentBrush}"
                                   RadiusX="2" RadiusY="2" Margin="0,0,10,0"/>
                        <TextBlock VerticalAlignment="Center">
                            <Run Text="AKI" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="15"/>
                            <Run Text="CINEMA" Foreground="White" FontSize="15"/>
                            <Run Text="  Касса" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="UserLabel" Foreground="{StaticResource MutedBrush}"
                                   FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/>

                        <!-- Minimize -->
                        <Button Content="─" Width="36" Height="32" Click="MinimizeButton_Click"
                                Style="{StaticResource BaseButtonStyle}"
                                Background="#1AF59E0B" Foreground="#F59E0B"
                                FontSize="14" Margin="0,0,2,0" ToolTip="Свернуть"/>

                        <!-- Maximize / Restore -->
                        <Button x:Name="MaxRestoreBtn" Content="❐" Width="36" Height="32"
                                Click="MaxRestoreButton_Click"
                                Style="{StaticResource BaseButtonStyle}"
                                Background="#1A22C55E" Foreground="#22C55E"
                                FontSize="14" Margin="0,0,2,0" ToolTip="Развернуть"/>

                        <!-- Close -->
                        <Button Content="✕" Width="36" Height="32" Click="CloseButton_Click"
                                Style="{StaticResource BaseButtonStyle}"
                                Background="#1AEF4444" Foreground="#EF4444"
                                FontSize="14" ToolTip="Закрыть"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ SIDEBAR ═══ -->
            <Border Grid.Row="1" Grid.Column="0"
                    Background="{StaticResource Bg2Brush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="8,16,8,0">
                        <TextBlock Text="НАВИГАЦИЯ" Foreground="{StaticResource MutedBrush}"
                                   FontSize="10" FontWeight="Bold" Margin="12,0,0,8"/>

                        <Button x:Name="BtnSchedule" Click="BtnSchedule_Click"
                                Style="{StaticResource NavButtonStyle}" Height="44">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📅" FontSize="16" Margin="0,0,10,0"/>
                                <TextBlock Text="Расписание" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnSearch" Click="BtnSearch_Click"
                                Style="{StaticResource NavButtonStyle}" Height="44" Margin="0,2,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔍" FontSize="16" Margin="0,0,10,0"/>
                                <TextBlock Text="Найти бронь" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Separator Background="{StaticResource BorderBrush}" Margin="12,12"/>

                        <TextBlock Text="СЕГОДНЯ" Foreground="{StaticResource MutedBrush}"
                                   FontSize="10" FontWeight="Bold" Margin="12,0,0,8"/>

                        <Border Background="{StaticResource Bg3Brush}" CornerRadius="8"
                                Padding="12,10" Margin="0,0,0,6">
                            <StackPanel>
                                <TextBlock x:Name="TodayDateLabel"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TodayScreeningsLabel"
                                           Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Logout -->
                    <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,1,0,0" Padding="8,8">
                        <Button Content="⏻  Выйти из системы"
                                Style="{StaticResource NavButtonStyle}"
                                Height="38" Click="LogoutButton_Click"
                                Foreground="#EF4444"/>
                    </Border>
                </Grid>
            </Border>

            <!-- ═══ CONTENT AREA ═══ -->
            <Frame Grid.Row="1" Grid.Column="1"
                   x:Name="ContentFrame"
                   NavigationUIVisibility="Hidden"
                   Background="{StaticResource BgBrush}"/>
        </Grid>
    </Border>
</Window>
